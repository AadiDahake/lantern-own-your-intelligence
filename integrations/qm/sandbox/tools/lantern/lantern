#!/usr/bin/env node
"use strict";
/**
 * lantern: the Lantern tool on a QM agent computer, and the formatter the host script reuses.
 *
 *   lantern gaps [--limit N] [--id GROUP_ID] [--from FILE] [--json]
 *
 * Reads the grouped gaps from `GET <LANTERN_URL>/api/requests` with the console token, or from a
 * saved copy of that response with --from. Prints them as plain text the agent can quote.
 */
const { readFileSync } = require("node:fs");

const DEFAULT_URL = "http://host.docker.internal:3000";

function parseArgs(argv) {
  const args = { command: argv[0], limit: 5, id: null, from: null, json: false };
  for (let i = 1; i < argv.length; i += 1) {
    const flag = argv[i];
    if (flag === "--json") args.json = true;
    else if (flag === "--limit") args.limit = Math.max(1, Number(argv[++i]) || 5);
    else if (flag === "--id") args.id = argv[++i] ?? null;
    else if (flag === "--from") args.from = argv[++i] ?? null;
    else throw new Error(`unknown option ${flag}`);
  }
  return args;
}

async function loadGaps(from) {
  if (from) return JSON.parse(readFileSync(from, "utf8")).requests ?? [];
  const base = (process.env.LANTERN_URL || DEFAULT_URL).replace(/\/+$/, "");
  const token = process.env.LANTERN_CONSOLE_TOKEN;
  if (!token) throw new Error("LANTERN_CONSOLE_TOKEN is not set, so Lantern will not answer.");
  const response = await fetch(`${base}/api/requests`, {
    headers: { authorization: `Bearer ${token}` },
  });
  if (!response.ok) throw new Error(`Lantern answered ${response.status} for /api/requests.`);
  const body = await response.json();
  return Array.isArray(body.requests) ? body.requests : [];
}

function day(iso) {
  return typeof iso === "string" && iso.length >= 10 ? iso.slice(0, 10) : "unknown";
}

/** One gap as the lines the room reads. Only fields Lantern returned appear. */
function formatGap(gap) {
  const lines = [
    `Lantern gap ${gap.id}: ${gap.title}`,
    `Area: ${gap.area || "unknown"}. Priority: ${gap.priority}. Status: ${gap.status}.`,
    `Reports: ${gap.reportCount} from ${gap.userReportCount} distinct users, first ${day(gap.firstSeen)}, last ${day(gap.lastSeen)}.`,
  ];
  if (gap.description) lines.push(`What users asked: ${gap.description}`);
  lines.push(`Issue: ${gap.issueUrl || "none yet"}. Pull request: ${gap.prUrl || "none yet"}.`);
  return lines.join("\n");
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.command !== "gaps") {
    process.stdout.write("usage: lantern gaps [--limit N] [--id GROUP_ID] [--from FILE] [--json]\n");
    process.exitCode = args.command ? 2 : 0;
    return;
  }
  const all = await loadGaps(args.from);
  const gaps = (args.id ? all.filter((gap) => gap.id === args.id) : all).slice(0, args.limit);
  if (args.json) {
    process.stdout.write(`${JSON.stringify(gaps.map((gap) => ({ gap, text: formatGap(gap) })))}\n`);
    return;
  }
  if (gaps.length === 0) {
    process.stdout.write(args.id ? `No Lantern gap has the id ${args.id}.\n` : "Lantern has no gaps yet.\n");
    return;
  }
  process.stdout.write(`${gaps.map(formatGap).join("\n\n")}\n`);
}

main().catch((error) => {
  process.stderr.write(`lantern: ${error.message}\n`);
  process.exitCode = 1;
});
